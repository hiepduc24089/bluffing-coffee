# Mẫu file env cho production.
#
# Trên server: copy thành `backend/.env.production`, điền giá trị thật rồi
# `chmod 600 .env.production`. File thật KHÔNG được commit.
#
# Sinh APP_KEY:
#   docker run --rm dunglas/frankenphp:1-php8.3-alpine php -r \
#     "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Sinh password ngẫu nhiên:
#   openssl rand -base64 24

APP_NAME="Bluffing Coffee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

# URL công khai của API (subdomain DuckDNS trỏ về IP của VM).
APP_URL=https://bluffing-api.duckdns.org

# Domain Caddy dùng để xin chứng chỉ Let's Encrypt.
# Phải trỏ đúng về IP public của VM TRƯỚC khi khởi động container lần đầu.
# Đặt `:80` nếu muốn test HTTP thuần, nhưng khi đó frontend trên Vercel (HTTPS)
# sẽ bị trình duyệt chặn vì mixed content.
SERVER_NAME=bluffing-api.duckdns.org

# Option global cho Caddy. Email để Let's Encrypt gửi cảnh báo hết hạn cert.
CADDY_GLOBAL_OPTIONS=email you@gmail.com

# Origin của frontend, dùng cho CORS (config/cors.php đọc biến này).
# Nhiều origin thì ngăn cách bằng dấu phẩy, KHÔNG có dấu / ở cuối.
# Thêm cả domain preview của Vercel nếu muốn test PR trên preview deploy.
FRONTEND_URL=https://bluffing-coffee.vercel.app

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# `mysql` là tên service trong docker-compose.prod.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bluffing_coffee
DB_USERNAME=bluffing_coffee
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

# Auth dùng Bearer token (Sanctum personal access token) nên không cần
# SANCTUM_STATEFUL_DOMAINS. Số phút token còn hiệu lực:
SANCTUM_EXPIRATION=10080

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

FILESYSTEM_DISK=public

MAIL_MAILER=log
