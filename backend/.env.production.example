# Mẫu file env cho production.
#
# Trên server: copy thành `backend/.env.production`, điền giá trị thật rồi
# `chmod 600 .env.production`. File thật KHÔNG được commit.
#
# Sinh APP_KEY:
#   docker run --rm dunglas/frankenphp:1-php8.3-alpine php -r \
#     "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Sinh password ngẫu nhiên:
#   openssl rand -base64 24

APP_NAME="Bluffing Coffee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh

# URL công khai của site. Frontend và API dùng chung domain này:
# `/api/*` vào Laravel, còn lại là SPA.
APP_URL=https://bluffing.duckdns.org

# Domain Caddy dùng để xin chứng chỉ Let's Encrypt.
# Phải trỏ đúng về IP public của VPS TRƯỚC khi khởi động container lần đầu.
# Đặt `:80` nếu muốn test HTTP thuần.
SERVER_NAME=bluffing.duckdns.org

# Option global cho Caddy. Email để Let's Encrypt gửi cảnh báo hết hạn cert.
CADDY_GLOBAL_OPTIONS=email you@gmail.com

# KHÔNG cần FRONTEND_URL trên production: frontend cùng origin với API nên
# không có request cross-origin nào để mà cấu hình CORS.

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# `daily` chứ KHÔNG phải `single`: storage/logs nằm trong named volume nên file
# log sống lâu hơn container, mà `single` thì ghi mãi vào một file không bao giờ
# rotate -> sớm muộn cũng đầy disk. `daily` tự xóa file cũ hơn LOG_DAILY_DAYS.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# `mysql` là tên service trong docker-compose.prod.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bluffing_coffee
DB_USERNAME=bluffing_coffee
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

# Auth dùng Bearer token (Sanctum personal access token) nên không cần
# SANCTUM_STATEFUL_DOMAINS. Số phút token còn hiệu lực:
SANCTUM_EXPIRATION=10080

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

FILESYSTEM_DISK=public

MAIL_MAILER=log
